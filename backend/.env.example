# Copy to .env for local development. All vars are optional.

# Comma-separated exact origins. Never "*".
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated slowapi limits, applied per client IP.
APP_RATE_LIMITS=10/minute,100/day

# Highest resolution offered. 1080 needs ffmpeg for most platforms.
APP_MAX_HEIGHT=1080

# Merged downloads estimated above this fall back to the best single stream.
APP_MAX_MERGE_BYTES=209715200

APP_MAX_CONCURRENT_DOWNLOADS=2
APP_FFMPEG_PATH=ffmpeg
APP_LOG_LEVEL=INFO

# Optional shared secret. When set, /api/resolve and /api/download require
# an X-App-Key header (frontend: set VITE_APP_KEY to the same value).
# APP_APP_KEY=
