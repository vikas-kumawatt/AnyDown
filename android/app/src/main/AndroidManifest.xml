<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Long downloads run in a foreground service, or Android kills the
         process partway through. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Runtime permission on Android 13+; the service notification needs it. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only needed up to Android 9. On 10+ scoped storage applies, and the app
         writes into the public Download/ directory, which needs no permission
         for files the app itself creates. -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".DownloaderApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AnyDown"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:usesCleartextTraffic="false"
        android:requestLegacyExternalStorage="true">
        <!-- youtubedl-android's docs say to set android:extractNativeLibs here,
             but AGP 8 warns about that and wants it in the build file instead.
             app/build.gradle.kts sets packaging.jniLibs.useLegacyPackaging,
             which is the same thing and takes precedence. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.AnyDown">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Lets you hit Share -> AnyDown from YouTube, TikTok, etc.
                 instead of copying and pasting the link. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
