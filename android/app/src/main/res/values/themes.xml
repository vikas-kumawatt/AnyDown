<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this only needs to avoid a white flash on
         launch and keep the system bars dark. -->
    <style name="Theme.AnyDown" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
